{
  "name": "tenki-mcp-app-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP App server: Tenki microVM sandboxes with interactive UIs (console, live preview, fleet).",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "serve": "tsx server.ts",
    "dev": "vite build && concurrently --kill-others --names ui,srv \"vite build --watch\" \"tsx watch --clear-screen=false server.ts\"",
    "typecheck": "tsc --noEmit",
    "warm": "tsx scripts/warm.ts",
    "smoke": "tsx scripts/smoke.ts",
    "capacity": "tsx scripts/capacity-watch.mts 15 30",
    "deploy": "tsx scripts/deploy-sandbox.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
