# Copy to .env — both the Next.js app and the MCP server read it. Never commit .env.

# ── Tenki (the microVMs) ─────────────────────────────────────────────────────
# A Tenki API key (tk_…). Without one the MCP server runs SIMULATED: the UI works,
# nothing executes, and every widget shows a SIMULATED badge.
TENKI_API_KEY=

# ── Model (pick one) ─────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (Aisa, OpenRouter, a relay…):
# LLM_BASE_URL=https://api.aisa.one/v1
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5
#
# Or Aisa by key alone (base URL defaults to https://api.aisa.one/v1):
# AISA_API_KEY=
#
# Or a first-party key (LLM_MODEL optionally overrides the default):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# MCP_PORT=3108
# TENKI_DEMO_TAG=copilotkit-mcp-apps   # tag on every sandbox the demo creates
# TENKI_REAP_MINUTES=60                # terminate demo sandboxes older than this, and any Tenki paused (0 disables)
# TENKI_SIMULATE=1                     # force simulated mode even with a key
