# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Every LUXOR_* variable below is also read under its legacy TENKI_* name (e.g. TENKI_API_KEY,
# TENKI_MCP_TRANSPORT); LUXOR_* wins when both are set.

# --- Auth (set one) ---
# Luxor API key, starts with lx_ (tk_ is still accepted)
LUXOR_API_KEY=lx_your_key_here
# Alternatively an ory_st_ session token or a session cookie (header chosen by prefix)
# LUXOR_AUTH_TOKEN=
# Override the control-plane endpoint (default: https://api.luxor.ai)
# LUXOR_API_ENDPOINT=https://api.luxor.ai

# --- Transport (optional) ---
# Set to "http" to serve Streamable HTTP instead of stdio
# LUXOR_MCP_TRANSPORT=http
# PORT=3000
# LUXOR_MCP_HTTP_HOST=127.0.0.1
# Required to bind a non-loopback host; sent as Authorization: Bearer <token>
# LUXOR_MCP_HTTP_TOKEN=

# --- Least-privilege controls (optional) ---
# Register only read-only tools (no create/run/delete/spend)
# LUXOR_MCP_READONLY=1
# Comma-separated tool names to drop, e.g. tenki_run_code,tenki_terminate_sandbox
# LUXOR_MCP_DISABLED_TOOLS=
# Log each tool call's name + argument keys (never values) to stderr
# LUXOR_MCP_AUDIT=1
