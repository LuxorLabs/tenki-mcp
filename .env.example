# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Auth (set one) ---
# Tenki API key, starts with tk_
TENKI_API_KEY=tk_your_key_here
# Alternatively an ory_st_ session token or a session cookie (header chosen by prefix)
# TENKI_AUTH_TOKEN=
# Override the control-plane endpoint (default: https://api.tenki.cloud)
# TENKI_API_ENDPOINT=https://api.tenki.cloud

# --- Transport (optional) ---
# Set to "http" to serve Streamable HTTP instead of stdio
# TENKI_MCP_TRANSPORT=http
# PORT=3000
# TENKI_MCP_HTTP_HOST=127.0.0.1
# Required to bind a non-loopback host; sent as Authorization: Bearer <token>
# TENKI_MCP_HTTP_TOKEN=

# --- Least-privilege controls (optional) ---
# Register only read-only tools (no create/run/delete/spend)
# TENKI_MCP_READONLY=1
# Comma-separated tool names to drop, e.g. tenki_run_code,tenki_terminate_sandbox
# TENKI_MCP_DISABLED_TOOLS=
# Log each tool call's name + argument keys (never values) to stderr
# TENKI_MCP_AUDIT=1
